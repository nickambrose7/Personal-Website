DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
COMMENTS_COOKIE_SECRET=replace-with-a-long-random-string
COMMENTS_ADMIN_PASSWORD=replace-with-a-long-password
# Optional: use a scrypt hash instead of COMMENTS_ADMIN_PASSWORD.
# Generate one with:
# node -e "const { randomBytes, scryptSync } = require('crypto'); const password = process.argv[1]; const salt = randomBytes(16).toString('hex'); console.log(`${salt}:${scryptSync(password, salt, 64).toString('hex')}`)" "your-password"
# COMMENTS_ADMIN_PASSWORD_HASH=
COMMENTS_ADMIN_SESSION_DAYS=7
COMMENTS_MAX_NAME_LENGTH=80
COMMENTS_MAX_EMAIL_LENGTH=254
COMMENTS_MAX_BODY_LENGTH=4000
COMMENTS_RATE_LIMIT_MAX_PER_IP=5
COMMENTS_RATE_LIMIT_MAX_PER_POST=3
COMMENTS_RATE_LIMIT_WINDOW_SECONDS=900
COMMENTS_DUPLICATE_COOLDOWN_SECONDS=3600
